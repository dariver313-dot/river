# 生产地址。宝塔反向代理必须写入 X-Forwarded-* 与 X-Real-IP 请求头。
DJMIMA_PUBLIC_ORIGIN=https://djmima.com
DJMIMA_TRUST_PROXY=1
DJMIMA_DATABASE_PATH=/app/data/djmima.sqlite
DJMIMA_BACKUP_DIR=/app/data/backups

# 初始管理员登录账号：邮箱，或 4–32 位英文数字组合（以字母开头且同时包含字母、数字）。
PRIMARY_ADMIN_ACCOUNT=admin@example.com

# 每一项均为独立随机密钥；不得复用、提交到 Git 或通过普通聊天工具发送。
VAULT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
VAULT_AUDIT_SIGNING_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
AUTH_TOTP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
# 用于一次性激活码、密码恢复码与登录地点确认的 HMAC；必须独立随机生成。
LOGIN_TOKEN_HASH_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY

# 初始管理员自己的 Google Authenticator Setup Key（Base32）。
PRIMARY_ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SECRET
# 用于首次打开 /setup#token=... 的一次性令牌；确认后入口立即失效，且必须设置过期时间。
SELFHOST_SETUP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_TOKEN
SELFHOST_SETUP_EXPIRES_AT=REPLACE_WITH_A_FUTURE_UTC_ISO_8601_TIMESTAMP

# 生产环境使用本地 MaxMind GeoLite2/GeoIP2 City MMDB 判断国家/地区；不会保存或向第三方发送原始登录 IP。
DJMIMA_GEOIP_DATABASE_PATH=/app/data/GeoLite2-City.mmdb

# 安全邮箱确认、账号激活和密码恢复邮件。生产环境中登录国家变化必须能够发送此邮件。
DJMIMA_SMTP_HOST=smtp.example.com
DJMIMA_SMTP_PORT=587
DJMIMA_SMTP_SECURE=0
DJMIMA_SMTP_USER=REPLACE_WITH_SMTP_USERNAME
DJMIMA_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
DJMIMA_SMTP_FROM=djmima@example.com

# 仅本地预览或受控自动化测试可开启；生产环境应保持未设置。
# DJMIMA_ALLOW_MANUAL_ACTIVATION_CODES=1
