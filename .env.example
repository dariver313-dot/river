# 生产地址。宝塔反向代理必须把 X-Forwarded-* 头写入容器。
DJMIMA_PUBLIC_ORIGIN=https://djmima.com
DJMIMA_TRUST_PROXY=1
DJMIMA_DATABASE_PATH=/app/data/djmima.sqlite
DJMIMA_BACKUP_DIR=/app/data/backups

# 初始管理员。邮箱只负责识别账户，不能替代验证码。
PRIMARY_ADMIN_EMAIL=admin@example.com

# 每一项均为独立的随机密钥；不要复用，不要提交到 Git，不要通过普通聊天工具发送。
# Base64URL 编码的 32 字节密钥：可用 `node scripts/generate-selfhost-secrets.mjs` 生成。
VAULT_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
VAULT_AUDIT_SIGNING_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY
AUTH_TOTP_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_KEY

# 初始管理员自己的 Google Authenticator Setup Key（Base32）。
# 其他用户的验证器密钥会在管理员创建该用户时单独生成。
PRIMARY_ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_TOTP_SECRET

# 用于首次打开 /setup?token=... 的一次性令牌。确认后入口立即失效。
SELFHOST_SETUP_TOKEN=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_TOKEN
