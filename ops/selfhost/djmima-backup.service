[Unit]
Description=djmima encrypted SQLite backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=DJMIMA_APP_DIR=/opt/djmima
EnvironmentFile=-/etc/default/djmima
ExecStart=/usr/bin/env docker compose --project-directory ${DJMIMA_APP_DIR} -f ${DJMIMA_APP_DIR}/compose.yaml exec -T djmima node scripts/selfhost-backup.mjs
NoNewPrivileges=true
PrivateTmp=true
