# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=8373296041

# Auth Service
AUTH_SERVICE_URL=http://127.0.0.1:3100/api/platform-a
AUTH_API_KEY=
AUTH_CLIENT_CONCURRENCY=8
AUTH_CLIENT_LOGIN_LOG_CONCURRENCY=2
API_TIMEOUT=10000

# Runtime
LOG_LEVEL=info
# 是否使用终端颜色；宝塔/面板日志建议关闭，避免出现控制字符。
LOG_COLOR=false
POLL_INTERVAL=15
EVALUATION_CONCURRENCY=3
PENDING_ORDER_LOOKBACK_HOURS=12
# Maximum pages per withdrawal status in a single poll (100 records per page).
# Reaching this cap logs a warning and keeps the newest orders responsive.
WITHDRAW_ORDER_MAX_PAGES=1
TZ_OFFSET=8
PORT=0
ALLOW_DB_REBUILD=false

# Login association rules
DAILY_LOGIN_MAX_PAGES=3
DAILY_LOGIN_PAGE_SIZE=50

# Successful-withdrawal history. Set a unique random 32+ character value in production.
# This value must remain unchanged after deployment, otherwise historical HMAC fingerprints cannot be compared.
# It is only used to HMAC local receiving-account fingerprints; raw card numbers are never used as database lookup keys.
RISK_FINGERPRINT_SECRET=
# Number of days to search confirmed withdrawals for the same receiving information.
RECEIVING_ASSOCIATION_DAYS=180

# Historical query scope, anchored to each withdrawal's Beijing timestamp.
LOTTERY_LOOKBACK_DAYS=7
WITHDRAWAL_HISTORY_DAYS=30
WITHDRAWAL_HISTORY_MAX_PAGES=3

# Telegram heavy query buttons. Platform A exposes no reliable full-history login timestamp,
# so the group profile query is intentionally limited to the current Beijing day.
HEAVY_QUERY_CONCURRENCY=2
PROFILE_LOGIN_MAX_PAGES=5
PROFILE_LOGIN_PAGE_SIZE=100

# Risk rules
PROXY_BLACKLIST=
AGENT_WHITELIST=
RISK_REMARK_KEYWORDS=套利,刷子,团伙,同人
