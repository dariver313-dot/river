generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model MemberProfile {
  memberName          String   @id
  memberId            String   @default("")
  evalCount           Int      @default(0)
  highRiskCount       Int      @default(0)
  maxRiskLevel        String   @default("")
  lastEvalAt          DateTime?
  lastEvalScore       Int      @default(0)
  topRules            String   @default("{}")
  totalWithdrawAmount Float    @default(0)
  recentWithdrawTrend String    @default("[]")
  lastWithdrawMethod  String    @default("")
  updatedAt           DateTime  @default(now())

  @@index([updatedAt])
}

model AgentProfile {
  proxyCode           String   @id
  memberCount         Int      @default(0)
  evalCount           Int      @default(0)
  highRiskCount       Int      @default(0)
  totalWithdrawAmount Float    @default(0)
  riskScore           Int      @default(0)
  topRules            String   @default("{}")
  updatedAt           DateTime @default(now())

  @@index([updatedAt])
}

model RiskEval {
  id             String   @id @default(cuid())
  orderId        String   @unique
  memberId       String
  memberName     String   @default("")
  totalScore     Int      @default(0)
  riskLevel      String   @default("LOW")
  triggeredRules String   @default("[]")
  detail         String   @default("{}")
  notified       Boolean  @default(false)
  finalStatus    String   @default("")
  feedback       String   @default("")
  notifyMsgId    Int?
  notifiedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([memberId])
  @@index([createdAt])
  @@index([riskLevel])
  @@index([finalStatus])
  @@index([notified, finalStatus])
  @@index([notified, feedback])
}

model RuleFeedback {
  id         String   @id @default(cuid())
  evalId     String
  ruleId     String
  feedback   String   @default("")
  memberId   String   @default("")
  periodInfo String   @default("")
  createdAt  DateTime @default(now())

  @@index([evalId])
  @@index([memberId])
  @@index([memberId, feedback, createdAt])
  @@index([memberId, feedback, ruleId])
  @@index([createdAt])
  @@unique([evalId, ruleId])
}

model BotConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")

  @@index([key])
}

/// 仅记录平台确认已出款（cashStatus=3）的订单。
/// 风控评估中的待处理订单不能写入这里，以免污染历史提款基准。
model SuccessfulWithdrawal {
  orderId              String   @id
  memberId             String
  memberName           String
  amount               Float    @default(0)
  receivingBank        String   @default("")
  receivingName        String   @default("")
  receivingCardNo      String   @default("")
  receivingFingerprint String   @default("")
  createTime           DateTime
  recordedAt           DateTime @default(now())

  @@index([memberId, createTime])
  @@index([memberName, createTime])
  @@index([receivingFingerprint, createTime])
}

/// 画像统计的订单级幂等凭证。每笔风控评估只允许贡献一次会员/代理画像。
model ProfileContribution {
  orderId    String   @id
  memberName String
  proxyCode  String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
