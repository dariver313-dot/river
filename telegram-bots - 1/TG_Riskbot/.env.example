# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_USER_IDS=8373296041

# Auth Service
AUTH_SERVICE_URL=http://127.0.0.1:3100/api/platform-b
AUTH_API_KEY=
AUTH_CLIENT_CONCURRENCY=8
AUTH_CLIENT_LOGIN_LOG_CONCURRENCY=2
API_TIMEOUT=10000

# Runtime
POLL_INTERVAL=25
# WebSocket 已连接时的兜底轮询间隔（秒，默认 30，最小 10）。
POLL_INTERVAL_WS_CONNECTED=30
# 每种提款状态每轮最多读取页数；单页 100 条，达到上限会记录告警并优先处理最新订单。
WITHDRAW_ORDER_MAX_PAGES=2
LOG_LEVEL=info
# 是否使用终端颜色；宝塔/面板日志建议关闭，避免出现控制字符。
LOG_COLOR=false
TZ_OFFSET=8
# 设为 0 时禁用内置 HTTP 服务；如需启用，仅建议监听本机地址。
PORT=0
# 内置 HTTP 服务的监听地址。
HOST=127.0.0.1
# 可选：固定通知群；未配置时由管理员在目标群使用 /bind
# NOTIFY_CHAT_ID=
# 可选：自定义 SQLite 路径；未配置时使用项目内 prisma/db/riskbot.db
# DATABASE_URL=file:./prisma/db/riskbot.db
# 可选：管理接口允许的前端来源
# CORS_ORIGIN=http://127.0.0.1:3000
ALLOW_DB_REBUILD=false

# WebSocket
WS_ENABLED=true
WS_URL=
WS_CONCURRENCY=3
# 每轮轮询同时查询最近提款的全状态列表，防止 WS 或单个状态页短暂遗漏。
# 默认 10 分钟窗口；每页 100 条，由下方页数限制最大读取量。
RECENT_ORDER_RECONCILE_WINDOW_MIN=10
# 全状态对账最多读取页数（1-10，默认 1）。达到上限时日志会告警。
RECENT_ORDER_RECONCILE_MAX_PAGES=1

# Evaluation and notification concurrency
POLL_EVAL_MAX_CONCURRENCY=8
PREFETCH_BATCH_SIZE=20
NOTIFY_CONCURRENCY=5
REPLAY_NOTIFY_CONCURRENCY=5
HEAVY_QUERY_CONCURRENCY=2

# Login association rules
DAILY_LOGIN_MAX_PAGES=3
DAILY_LOGIN_PAGE_SIZE=50
PROFILE_LOGIN_MAX_PAGES=5
PROFILE_LOGIN_PAGE_SIZE=100

# Historical risk data (all windows end at the withdrawal creation timestamp)
# Lottery violations use a rolling window; 7 days balances evasion resistance and API load.
LOTTERY_VIOLATION_LOOKBACK_DAYS=7
# Each lottery page fans out to settled statuses 5/6/7 in auth-service.
LOTTERY_BETS_MAX_PAGES=5
# Successful withdrawal history is used by trend and receiving-method rules.
WITHDRAW_HISTORY_DAYS=30
WITHDRAW_HISTORY_MAX_PAGES=5
# Successful recharge and manual account-change pagination limits.
PAYMENT_ORDER_MAX_PAGES=3
ACCOUNT_CHANGE_MAX_PAGES=3
# 收款姓名/卡号指纹密钥，必须配置私有随机值；不要使用 AUTH_API_KEY 代替。
RISK_FINGERPRINT_SECRET=
# Same receiving name/card is considered related within this many days.
RECEIVING_ASSOCIATION_DAYS=180

# Risk rules
PROXY_BLACKLIST=
AGENT_WHITELIST=
RISK_REMARK_KEYWORDS=套利,刷子,团伙,同人
