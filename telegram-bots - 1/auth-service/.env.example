# ============================================================
# Auth Service 配置模板
# 复制为 .env 后填入真实值
#
# 敏感值加密方法：
#   $env:AUTH_SECRET_KEY="<你的密钥>"; npx ts-node src/encrypt.ts
#   然后输入明文值，将输出的密文填入 _ENC 字段
# ============================================================

# 服务端口
PORT=3100
# 仅供同机机器人使用时建议设为 127.0.0.1；跨服务器调用时按网络拓扑配置
HOST=127.0.0.1

# ---------- 机器人 API Key（至少配置 BOT_API_KEYS_ENC）----------
# 多个 Key 用逗号分隔
BOT_API_KEYS_ENC=<AES-256-GCM 密文>
# 金融权限 Key（加款操作），未配置则加款接口返回 403
BOT_FINANCE_KEYS_ENC=<AES-256-GCM 密文>
# 管理员权限 Key（setToken/status），未配置则管理接口返回 403
BOT_ADMIN_KEYS_ENC=<AES-256-GCM 密文>
# 平台B WebSocket Token 专用授权（填 TG_Riskbot 的查询 Key；该 Key 同时保留在 BOT_API_KEYS）
BOT_WS_KEYS_ENC=<AES-256-GCM 密文>

# ---------- IP 白名单（可选，逗号分隔）----------
# 支持单个 IP 和 CIDR 格式
# BOT_IP_WHITELIST=10.0.0.1,192.168.1.0/24,127.0.0.1

# ---------- 平台A - 澳博体系（Bearer JWT）----------
# 使用此平台的机器人：TG_Aobo、AB_Riskbot
PLATFORM_A_BASE_URL_ENC=<AES-256-GCM 密文>
PLATFORM_A_TOTP_SECRET_ENC=<AES-256-GCM 密文>

# 平台A 自动登录（可选，未配置则需手动 setToken）
AUTO_LOGIN_ACCOUNT_ENC=<AES-256-GCM 密文>
AUTO_LOGIN_PASSWORD_ENC=<AES-256-GCM 密文>
AUTO_LOGIN_TOTP_SECRET_ENC=<AES-256-GCM 密文>
RSA_PUBLIC_KEY_ENC=<AES-256-GCM 密文>

# ---------- 平台B - 娱乐城体系（X-AUTH-TOKEN + SM4）----------
# 使用此平台的机器人：TG_Robot、TG_Riskbot
PLATFORM_B_ROBOT_BASE_URL_ENC=<AES-256-GCM 密文>
PLATFORM_B_RISK_BASE_URL_ENC=<AES-256-GCM 密文>
PLATFORM_B_TOTP_SECRET_ENC=<AES-256-GCM 密文>
PLATFORM_B_WS_URL_ENC=<AES-256-GCM 密文>

# 平台B 自动登录（可选，未配置则需手动 setToken）
PLATFORM_B_LOGIN_ACCOUNT_ENC=<AES-256-GCM 密文>
PLATFORM_B_LOGIN_PASSWORD_ENC=<AES-256-GCM 密文>

# 租户代码（默认 CSZH）
# PLATFORM_B_TENANT_CODE=CSZH

# ---------- 通用 ----------
TZ_OFFSET=8
API_TIMEOUT=10000
# SOFT_TTL_MINUTES=5
# 查询/加款/管理接口每个 API Key 的每分钟限流，默认分别为 120 / 30 / 5
# QUERY_RATE_LIMIT_PER_MIN=120
# FINANCE_RATE_LIMIT_PER_MIN=30
# SET_TOKEN_RATE_LIMIT_PER_MIN=5
# WS Token 接口每个专用 Key 的每分钟限流
# WS_RATE_LIMIT_PER_MIN=60
# 金融幂等记录持久化；相对路径固定以 auth-service 项目目录为基准
# IDEMPOTENCY_STORE_PATH=data/idempotency-store.json
# IDEMPOTENCY_TTL_MINUTES=1440
# IDEMPOTENCY_MAX_ENTRIES=50000

# ---------- HTTPS（可选）----------
# 设置以下两个路径后自动启用 HTTPS
# HTTPS_KEY_PATH=/path/to/privkey.pem
# HTTPS_CERT_PATH=/path/to/fullchain.pem

# ---------- 注意 ----------
# AUTH_SECRET_KEY 不写在此文件！必须通过环境变量注入
# PowerShell: $env:AUTH_SECRET_KEY="<64位hex>"; node dist/index.js
# Linux:      AUTH_SECRET_KEY="<64位hex>" node dist/index.js
#
# 如果上游 API 在特定网络环境需 IPv4 优先：
# Linux:   NODE_OPTIONS=--dns-result-order=ipv4first node dist/index.js
# Windows: $env:NODE_OPTIONS="--dns-result-order=ipv4first"; node dist/index.js
