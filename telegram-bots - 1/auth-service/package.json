{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Auth Service - 统一认证代理，机器人不拿Token",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:ipv4": "NODE_OPTIONS=--dns-result-order=ipv4first node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:ipv4": "NODE_OPTIONS=--dns-result-order=ipv4first ts-node src/index.ts"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "gm-crypto": "^0.1.12",
    "sm-crypto-v2": "^1.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
